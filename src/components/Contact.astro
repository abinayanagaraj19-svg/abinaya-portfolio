<section class="section contact-section" id="contact">
  <div class="contact-glow"></div>

  <div class="wrap contact-wrap">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">HAVE A PROJECT IN MIND?</p>
      <h2>
        Let’s build something<br />
        <span class="gradient-text">amazing together.</span>
      </h2>
      <p class="section-subtitle">
        Open to conversations about internships, collaboration, and ideas worth building.
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-details" data-reveal>
        <p class="contact-lead">The best work starts with a good conversation.</p>

        <a class="contact-item" href="mailto:abinayanagaraj19@gmail.com">
          <span class="contact-icon">✉</span>
          <span>
            <small>EMAIL</small>
            <strong>abinayanagaraj19@gmail.com</strong>
          </span>
        </a>

        <a
          class="contact-item"
          href="https://www.linkedin.com/in/abinaya-nagaraj-57b407326/"
          target="_blank"
          rel="noreferrer"
        >
          <span class="contact-icon">in</span>
          <span>
            <small>LINKEDIN</small>
            <strong>View my profile ↗</strong>
          </span>
        </a>

        <a
          class="contact-item"
          href="https://github.com/abinayanagaraj19-svg"
          target="_blank"
          rel="noreferrer"
        >
          <span class="contact-icon">⌘</span>
          <span>
            <small>GITHUB</small>
            <strong>View my profile ↗</strong>
          </span>
        </a>
      </div>

      <form class="contact-form glass-card" data-contact-form data-reveal>
        <label for="name">Your name</label>
        <input
          id="name"
          name="name"
          autocomplete="name"
          placeholder="Jane Smith"
          required
        />

        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="jane@example.com"
          required
        />

        <label for="message">Your message</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Tell me what you’re thinking about..."
          required
        ></textarea>

        <button class="button button-primary" type="submit">
          Check message <span>↗</span>
        </button>

        <p class="form-note" data-form-status role="status">
          Demo form only — no message will be sent until a delivery endpoint is configured.
        </p>
      </form>
    </div>
  </div>
</section>