---
const groups = [
  { icon: '⌘', title: 'Programming', items: ['Java', 'Python', 'JavaScript'] },
  { icon: '◈', title: 'Frontend', items: ['HTML', 'CSS', 'React.js'] },
  { icon: '⌁', title: 'Backend', items: ['Node.js', 'Express.js'] },
  { icon: '▤', title: 'Database', items: ['MySQL', 'SQL'] },
  { icon: '✳', title: 'AI & Tools', items: ['Gemini API', 'Git', 'GitHub', 'VS Code'] },
];
---
<section class="section" id="skills"><div class="wrap"><div class="section-heading centered" data-reveal><p class="eyebrow">MY TOOLKIT</p><h2>Tools I use to <span class="gradient-text">bring ideas to life.</span></h2><p class="section-subtitle">A growing set of tools for building, learning, and solving problems.</p></div><div class="skills-grid">{groups.map((group) => <article class="skill-card glass-card" data-reveal><div class="skill-card-head"><span class="skill-icon">{group.icon}</span><h3>{group.title}</h3></div><div class="skill-tags">{group.items.map((item) => <span>{item}</span>)}</div></article>)}</div></div></section>
